# Base de datos (MySQL por Docker, puerto 3308)
DATABASE_URL="mysql://inventario:inventario@localhost:3308/inventario"

# NextAuth v5 (Auth.js) — generar con: npx auth secret
AUTH_SECRET=""

# Credenciales OAuth de Google Cloud (APIs & Services > Credentials > OAuth client ID)
# Redirect URI autorizada: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL publica de la app; en produccion debe apuntar al dominio real
AUTH_URL="http://localhost:3000"

# Necesario cuando la app corre detras de un proxy o en Docker
AUTH_TRUST_HOST="true"
